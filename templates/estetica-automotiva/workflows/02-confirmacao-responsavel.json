    {
      "parameters": {
        "jsCode": "function parseDateTime(message, timezone) {\n  const m = String(message || \"\").toLowerCase();\n  let date = \"\";\n  let time = \"\";\n\n  const dmatch = m.match(/(\\d{1,2})[\\/\\-](\\d{1,2})(?:[\\/\\-](\\d{2,4}))?/);\n  if (dmatch) {\n    const dd = dmatch[1].padStart(2, \"0\");\n    const mm = dmatch[2].padStart(2, \"0\");\n    const yy = dmatch[3] ? (dmatch[3].length === 2 ? \"20\" + dmatch[3] : dmatch[3]) : String(new Date().getFullYear());\n    date = `${dd}/${mm}/${yy}`;\n  } else if (m.includes(\"amanhã\") || m.includes(\"amanha\")) {\n    const d = new Date();\n    d.setDate(d.getDate() + 1);\n    date = d.toLocaleDateString(\"pt-BR\", { timeZone: timezone });\n  } else if (m.includes(\"hoje\")) {\n    const d = new Date();\n    date = d.toLocaleDateString(\"pt-BR\", { timeZone: timezone });\n  }\n\n  const timeMatches = [...m.matchAll(/(?:às|as|por volta das|horário|horario)?\\s*(\\d{1,2})(?:[:h](\\d{2}))?\\s*(?:h|hrs|horas)?/g)];\n  for (const tm of timeMatches) {\n    const hh = tm[1].padStart(2, \"0\");\n    const mm = (tm[2] || \"00\").padStart(2, \"0\");\n    const hnum = Number(hh);\n    if (hnum >= 6 && hnum <= 22) {\n      time = `${hh}:${mm}`;\n      break;\n    }\n  }\n\n  return { date, time };\n}\n\nfunction cleanSuggestionText(text) {\n  return String(text || \"\")\n    .replace(/^\\s*(não|nao|n)\\b\\s*[,\\-:;]?\\s*/i, \"\")\n    .replace(/^\\s*(disponível|disponivel)\\s*[,\\-:;]?\\s*/i, \"\")\n    .trim();\n}\n\nconst ag = $json.agendamento;\nconst textoLimpo = $json.resposta_responsavel?.texto_limpo || $json.resposta_responsavel?.texto || \"\";\nconst dt = parseDateTime(textoLimpo, $json.config.atendimento.timezone);\n\nlet sugestao_texto = cleanSuggestionText(textoLimpo);\nif (dt.date && dt.time) sugestao_texto = `${dt.date} às ${dt.time}`;\nelse if (!sugestao_texto) sugestao_texto = \"novo horário informado pelo responsável\";\n\nconst body = {\n  status: \"AGUARDANDO_CLIENTE_ACEITAR_SUGESTAO\",\n  sugestao_data: dt.date || null,\n  sugestao_hora: dt.time || null,\n  sugestao_texto,\n  resposta_responsavel: $json.resposta_responsavel.texto,\n  updated_at: new Date().toISOString()\n};\n\nconst text = `O horário que você escolheu não está disponível.\n\nO horário mais próximo disponível é: ${sugestao_texto}\n\nPosso confirmar esse novo horário para você?\nResponda SIM para confirmar.`;\n\nreturn [{ json: { ...$json, supabase_body: body, destino: \"cliente\", text } }];"
      },
