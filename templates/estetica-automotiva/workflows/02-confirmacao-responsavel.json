        "jsCode": "function digits(v) {\n  return String(v || \"\").replace(/\\D/g, \"\");\n}\n\nfunction txt(v) {\n  return String(v || \"\").trim();\n}\n\nconst raw = $json.raw || {};\nconst config = $json.config;\n\nconst incoming = {\n  from: digits(raw.from || raw.body?.from || raw.payload?.from || raw.sender || raw.chatId || raw.key?.remoteJid),\n  body: txt(raw.body?.body || raw.body?.text || raw.body || raw.text || raw.message || raw.payload?.body || raw.payload?.text || raw.message?.body),\n  pushName: txt(raw.pushName || raw.body?.pushName || raw._data?.notifyName || raw.name || \"\")\n};\n\nreturn [{ json: { config, incoming } }];"
