      "id": "30b7e823-d162-44b1-ab6c-4af0b2769f70",
      "name": "13 - Responder Webhook OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2300,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizeText(value) {\n  return String(value || \"\")\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .trim();\n}\n\nfunction extractAgendamentoId(message) {\n  const text = String(message || \"\").trim();\n  const byLabel = text.match(/(?:^|\\b)(?:id|agendamento|agenda|#)\\s*[:\\-]?\\s*([a-zA-Z0-9_-]{1,80})/i);\n  if (byLabel) return byLabel[1];\n\n  const uuid = text.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i);\n  if (uuid) return uuid[0];\n\n  const firstNumber = text.match(/^\\s*(\\d{1,20})\\b/);\n  if (firstNumber) return firstNumber[1];\n\n  return \"\";\n}\n\nfunction stripIdFromMessage(message, agendamentoId) {\n  let text = String(message || \"\").trim();\n  if (agendamentoId) {\n    const escaped = String(agendamentoId).replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n    text = text\n      .replace(new RegExp(`(?:^|\\\\b)(?:id|agendamento|agenda|#)\\\\s*[:\\\\-]?\\\\s*${escaped}`, \"i\"), \" \")\n      .replace(new RegExp(`^\\\\s*${escaped}\\\\b`, \"i\"), \" \");\n  }\n  return text.replace(/^\\s*[,\\-:;]+\\s*/, \"\").trim();\n}\n\nfunction decide(cleanMessage) {\n  const n = normalizeText(cleanMessage);\n\n  const negativePatterns = [\n    /^(nao|n)\\b/, /\\bnao da\\b/, /\\bnao pode\\b/, /\\bsem vaga\\b/, /\\bindisponivel\\b/, /\\bocupado\\b/, /\\boutro horario\\b/, /\\bsugere\\b/\n  ];\n  if (negativePatterns.some(rx => rx.test(n))) return \"NEGAR_SUGERIR\";\n\n  const positivePatterns = [\n    /^(sim|s)\\b/, /\\bsim\\b/, /\\bok\\b/, /\\bokay\\b/, /\\bpode\\b/, /\\bpode ser\\b/, /\\bconfirmado\\b/, /\\bconfirma\\b/, /\\bconfirmar\\b/, /\\bfechado\\b/, /\\bfecha\\b/, /\\bbeleza\\b/, /\\bblz\\b/, /\\bcerto\\b/, /\\bta bom\\b/, /\\btudo certo\\b/, /\\bmanda\\b/, /\\bmanda bala\\b/\n  ];\n  if (positivePatterns.some(rx => rx.test(n))) return \"CONFIRMAR\";\n\n  return \"INVALIDA\";\n}\n\nconst message = $json.incoming?.body || \"\";\nconst agendamento_id = extractAgendamentoId(message);\nconst texto_limpo = stripIdFromMessage(message, agendamento_id);\nconst decisao = decide(texto_limpo);\n\nreturn [{\n  json: {\n    ...$json,\n    resposta_responsavel: {\n      texto: message,\n      texto_limpo,\n      agendamento_id,\n      decisao,\n      tem_id: Boolean(agendamento_id)\n    }\n  }\n}];"
      },
