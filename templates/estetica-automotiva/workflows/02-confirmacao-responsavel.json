        "jsCode": "// ===================================================\n// CONFIG CLIENTE — TEMPLATE GENÉRICO PARA VENDA\n// ===================================================\nconst config = {\n  empresa: {\n    nome: \"NOME_DO_CLIENTE\",\n    cidade: \"CIDADE_DO_CLIENTE\",\n    telefone_responsavel: \"55DDDNUMERO\",\n    waha_base_url: \"http://IP_DA_VPS:3000\",\n    waha_api_key: \"SUA_WAHA_API_KEY\",\n    session: \"default\"\n  },\n\n  supabase: {\n    url: \"https://SEU_PROJECT_REF.supabase.co\",\n    service_role_key: \"SUA_SUPABASE_SERVICE_ROLE_KEY\"\n  },\n\n  atendimento: {\n    timezone: \"America/Campo_Grande\",\n    mensagem_resposta_invalida: \"Resposta não entendida. Responda com ID + confirmação. Ex: ID 123 SIM ou ID 123 NÃO, disponível 10/05 às 16:00\",\n    mensagem_sem_pendente: \"Não encontrei agendamento pendente com esse ID.\",\n    mensagem_sem_id: \"Para evitar conflito, responda incluindo o ID do agendamento. Ex: ID 123 SIM ou ID 123 NÃO, disponível 10/05 às 16:00\"\n  }\n};\n\nreturn [{ json: { raw: $json, config } }];"
