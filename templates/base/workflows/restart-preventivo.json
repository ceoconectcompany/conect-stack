            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02 - Executar Restart WAHA": {
      "main": [
        [
          {
            "node": "03 - Aguardar Pós Restart",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "03 - Aguardar Pós Restart": {
      "main": [
        [
          {
            "node": "04 - Verificar Depois do Restart",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "04 - Verificar Depois do Restart": {
      "main": [
        [
          {
            "node": "05 - Avaliar Restart WAHA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "05 - Avaliar Restart WAHA": {
      "main": [
        [
          {
            "node": "06 - IF Restart Falhou?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "06 - IF Restart Falhou?": {
      "main": [
        [
          {
            "node": "07 - Telegram Avisar Restart Falhou",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
