            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cmd-chegou",
              "leftValue": "={{ $json.comando }}",
              "rightValue": "CHEGOU",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cmd-faltou",
              "leftValue": "={{ $json.comando }}",
              "rightValue": "FALTOU",
              "operator": {
