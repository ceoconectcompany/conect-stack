    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.config.supabase.url + '/rest/v1/agendamentos?status=eq.CONFIRMADO&order=created_at.desc&limit=10&select=*' }}",
        "sendHeaders": true,
        "headerParameters": {
