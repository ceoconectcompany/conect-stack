      "parameters": {
        "jsCode": "const text = `Não encontrei um agendamento confirmado para marcar como ${$json.comando}.\n\nDica:\nEnvie CHEGOU ou FALTOU logo após o lembrete de 30 minutos.\n\nSe quiser marcar um agendamento específico, envie:\nCHEGOU ID_DO_AGENDAMENTO\nou\nFALTOU ID_DO_AGENDAMENTO`;\n\nreturn [{ json: { ...$json, destino: \"responsavel\", text } }];"
      },
      "id": "5ee7ff8b-8da7-4c0f-918a-530a1a06e430",
