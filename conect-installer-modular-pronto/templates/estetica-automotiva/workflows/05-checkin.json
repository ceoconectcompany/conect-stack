      "parameters": {
        "jsCode": "const config = $json.config;\nconst destino = $json.destino || \"responsavel\";\nconst chatId = destino === \"responsavel\" ? config.empresa.telefone_responsavel : $json.incoming.from;\n\nreturn [{\n  json: {\n    action: \"send\",\n    waha_base_url: config.empresa.waha_base_url,\n    waha_api_key: config.empresa.waha_api_key,\n    session: config.empresa.session,\n    chatId,\n    text: $json.text\n  }\n}];"
      },
