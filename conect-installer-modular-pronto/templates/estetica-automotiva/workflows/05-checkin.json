      "id": "12d38189-7b3a-4872-90ab-a054de2989bd",
      "name": "07B - Supabase Buscar Confirmado Mais Próximo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "function parseDateBr(dateBr, time) {\n  if (!dateBr || !time) return null;\n  const parts = String(dateBr).split(\"/\");\n  if (parts.length !== 3) return null;\n  const [dd, mm, yyyy] = parts;\n  const [hh, min] = String(time).split(\":\");\n  return new Date(Number(yyyy), Number(mm) - 1, Number(dd), Number(hh || 0), Number(min || 0), 0);\n}\n\nlet previous;\ntry {\n  previous = $item(0).$node[\"06 - IF Tem ID?\"].json;\n} catch (e) {\n  previous = $item(0).$node[\"05 - IF Comando Válido?\"].json;\n}\n\nconst rows = Array.isArray($json) ? $json : [];\nlet agendamento = rows[0] || null;\n\n// Se veio lista sem ID, tenta escolher o agendamento confirmado mais próximo do horário atual.\nif (!previous.agendamento_id && rows.length) {\n  const now = new Date();\n\n  const ranked = rows\n    .map(ag => {\n      const dataBase = ag.data_confirmada || ag.data_desejada || \"\";\n      const horaBase = ag.hora_confirmada || ag.hora_desejada || \"\";\n      const dt = parseDateBr(dataBase, horaBase);\n      const diffAbs = dt ? Math.abs(dt.getTime() - now.getTime()) : Number.MAX_SAFE_INTEGER;\n      return { ag, diffAbs };\n    })\n    .sort((a, b) => a.diffAbs - b.diffAbs);\n\n  agendamento = ranked[0]?.ag || rows[0] || null;\n}\n\nreturn [{ json: { ...previous, agendamento } }];"
      },
      "id": "18b88d99-da0d-40b3-9d27-f632e9acc8b1",
      "name": "08 - Escolher Agendamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "found",
              "leftValue": "={{ $json.agendamento?.id || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "beb34bd9-77a5-4fa4-8043-d1a6e0df1445",
      "name": "09 - IF Achou Agendamento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1260,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const comando = $json.comando;\nconst ag = $json.agendamento;\n\nconst body = {\n  updated_at: new Date().toISOString()\n};\n\nlet text = \"\";\n\nif (comando === \"CHEGOU\") {\n  body.status = \"CLIENTE_CHEGOU\";\n  body.resultado_operacional = \"CHEGOU\";\n  body.checkin_at = new Date().toISOString();\n\n  text = `✅ Check-in registrado!\n\nStatus: CLIENTE CHEGOU\n\nCliente: ${ag.cliente_nome || \"Não informado\"}\nWhatsApp: https://wa.me/${ag.cliente_telefone}\nServiço: ${ag.servico_nome}\nVeículo: ${ag.veiculo}\nHorário: ${ag.data_confirmada || ag.data_desejada} às ${ag.hora_confirmada || ag.hora_desejada}`;\n}\n\nif (comando === \"FALTOU\") {\n  body.status = \"CLIENTE_FALTOU\";\n  body.resultado_operacional = \"FALTOU\";\n  body.faltou_at = new Date().toISOString();\n\n  text = `❌ Falta registrada!\n\nStatus: CLIENTE FALTOU\n\nCliente: ${ag.cliente_nome || \"Não informado\"}\nWhatsApp: https://wa.me/${ag.cliente_telefone}\nServiço: ${ag.servico_nome}\nVeículo: ${ag.veiculo}\nHorário: ${ag.data_confirmada || ag.data_desejada} às ${ag.hora_confirmada || ag.hora_desejada}`;\n}\n\nreturn [{ json: { ...$json, supabase_body: body, destino: \"responsavel\", text } }];"
      },
