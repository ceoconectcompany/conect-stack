            "index": 0
          }
        ]
      ]
    },
    "02 - Ping WAHA API": {
      "main": [
        [
          {
            "node": "03 - Avaliar Ping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "03 - Avaliar Ping": {
      "main": [
        [
          {
            "node": "04 - IF Ping Falhou?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "04 - IF Ping Falhou?": {
      "main": [
        [
          {
            "node": "05 - Telegram Avisar Ping Falhou",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
