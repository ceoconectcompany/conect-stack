    {
      "parameters": {
        "jsCode": "const ag = $json.agendamento;\nconst body = {\n  status: \"CONFIRMADO\",\n  data_confirmada: ag.data_desejada,\n  hora_confirmada: ag.hora_desejada,\n  lembrete_enviado: false,\n  confirmed_at: new Date().toISOString(),\n  updated_at: new Date().toISOString()\n};\n\nconst text = `✅ Agendamento confirmado!\n\nServiço: ${ag.servico_nome}\nVeículo: ${ag.veiculo}\nData: ${ag.data_desejada}\nHorário: ${ag.hora_desejada}\nTempo estimado: ${ag.tempo_texto}\nValor: ${ag.preco_texto}\n\nQualquer coisa, é só chamar. 🚗✨`;\n\nreturn [{ json: { ...$json, supabase_body: body, destino: \"cliente\", text } }];"
      },
