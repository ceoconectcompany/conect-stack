    {
      "parameters": {
        "jsCode": "function parseDateTime(message, timezone) {\n  const m = String(message || \"\").toLowerCase();\n  let date = \"\";\n  let time = \"\";\n  const dmatch = m.match(/(\\d{1,2})[\\/\\-](\\d{1,2})(?:[\\/\\-](\\d{2,4}))?/);\n  if (dmatch) {\n    const dd = dmatch[1].padStart(2, \"0\");\n    const mm = dmatch[2].padStart(2, \"0\");\n    const yy = dmatch[3] ? (dmatch[3].length === 2 ? \"20\" + dmatch[3] : dmatch[3]) : String(new Date().getFullYear());\n    date = `${dd}/${mm}/${yy}`;\n  } else if (m.includes(\"amanhã\") || m.includes(\"amanha\")) {\n    const d = new Date(); d.setDate(d.getDate() + 1);\n    date = d.toLocaleDateString(\"pt-BR\", { timeZone: timezone });\n  } else if (m.includes(\"hoje\")) {\n    const d = new Date();\n    date = d.toLocaleDateString(\"pt-BR\", { timeZone: timezone });\n  }\n\n  const tmatch = m.match(/(?:às|as|por volta das|horário|horario)?\\s*(\\d{1,2})(?:[:h](\\d{2}))?\\s*(?:h|hrs|horas)?/);\n  if (tmatch) {\n    const hh = tmatch[1].padStart(2, \"0\");\n    const mm = (tmatch[2] || \"00\").padStart(2, \"0\");\n    const hnum = Number(hh);\n    if (hnum >= 6 && hnum <= 22) time = `${hh}:${mm}`;\n  }\n  return { date, time };\n}\n\nconst ag = $json.agendamento;\nconst dt = parseDateTime($json.incoming.body, $json.config.atendimento.timezone);\nconst fallback = String($json.incoming.body || \"\").replace(/^não,?/i, \"\").replace(/^nao,?/i, \"\").trim();\nconst sugestao_texto = dt.date && dt.time ? `${dt.date} às ${dt.time}` : fallback;\n\nconst body = {\n  status: \"AGUARDANDO_CLIENTE_ACEITAR_SUGESTAO\",\n  sugestao_data: dt.date || null,\n  sugestao_hora: dt.time || null,\n  sugestao_texto,\n  resposta_responsavel: $json.incoming.body,\n  updated_at: new Date().toISOString()\n};\n\nconst text = `O horário que você escolheu não está disponível.\n\nO horário mais próximo disponível é: ${sugestao_texto}\n\nPosso confirmar esse novo horário para você?\nResponda SIM para confirmar.`;\n\nreturn [{ json: { ...$json, supabase_body: body, destino: \"cliente\", text } }];"
      },
