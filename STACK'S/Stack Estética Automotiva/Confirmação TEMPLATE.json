    {
      "parameters": {
        "jsCode": "// ===================================================\n// CONFIG CLIENTE — TEMPLATE GENÉRICO PARA VENDA\n// ===================================================\nconst config = {\n  empresa: {\n    nome: \"NOME_DO_CLIENTE\",\n    cidade: \"CIDADE_DO_CLIENTE\",\n    telefone_responsavel: \"55DDDNUMERO\",\n    waha_base_url: \"http://IP_DA_VPS:3000\",\n    waha_api_key: \"SUA_WAHA_API_KEY\",\n    session: \"default\"\n  },\n\n  supabase: {\n    url: \"https://SEU_PROJECT_REF.supabase.co\",\n    service_role_key: \"SUA_SUPABASE_SERVICE_ROLE_KEY\"\n  },\n\n  atendimento: {\n    timezone: \"America/Campo_Grande\",\n    mensagem_resposta_invalida: \"Resposta não entendida. Responda SIM ou NÃO, disponível DD/MM às HH:MM\",\n    mensagem_sem_pendente: \"Não encontrei nenhum agendamento pendente para confirmar.\"\n  }\n};\n\nreturn [{ json: { raw: $json, config } }];"
      },
      "id": "0fc4e148-22fe-44af-b07a-ec08300443fa",
      "name": "01 - CONFIG CLIENTE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "function digits(v) {\n  return String(v || \"\").replace(/\\D/g, \"\");\n}\n\nfunction txt(v) {\n  return String(v || \"\").trim();\n}\n\nconst raw = $json.raw || {};\nconst config = $json.config;\n\nconst incoming = {\n  from: digits(raw.from || raw.body?.from || raw.payload?.from || raw.sender || raw.chatId || raw.key?.remoteJid),\n  body: txt(raw.body?.body || raw.body?.text || raw.body || raw.text || raw.message || raw.payload?.body || raw.payload?.text || raw.message?.body),\n  pushName: txt(raw.pushName || raw.body?.pushName || raw._data?.notifyName || raw.name || \"\")\n};\n\nreturn [{ json: { config, incoming } }];"
      },
