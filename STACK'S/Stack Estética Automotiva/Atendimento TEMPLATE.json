    {
      "parameters": {
        "jsCode": "const previous = $item(0).$node[\"06 - Restaurar Contexto Pós-Upsert\"].json;\nconst rows = Array.isArray($json) ? $json : [];\nconst cliente = rows[0] || {};\nconst draft = {\n  servico: cliente.draft_servico || \"\",\n  veiculo: cliente.draft_veiculo || \"\",\n  data_desejada: cliente.draft_data || \"\",\n  hora_desejada: cliente.draft_hora || \"\"\n};\n\nreturn [{ json: { ...previous, cliente, draft } }];"
      },
      "id": "6c544362-6ecf-4ac6-935b-815ea9daff17",
      "name": "08 - Preparar Contexto Cliente",
