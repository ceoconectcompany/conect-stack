    {
      "parameters": {
        "jsCode": "function cleanJsonText(t) {\n  return String(t || \"\").replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n}\n\nconst content = $json.choices?.[0]?.message?.content || \"{}\";\nlet ai = {};\n\ntry {\n  ai = JSON.parse(cleanJsonText(content));\n} catch (e) {\n  ai = {\n    intencao: \"FORA_ESCOPO\",\n    servico: \"\",\n    veiculo: \"\",\n    data_desejada: \"\",\n    hora_desejada: \"\",\n    resposta_curta: \"Não consegui entender com segurança.\",\n    confianca: 0\n  };\n}\n\nconst previous = $item(0).$node[\"12 - Montar Prompt IA\"].json;\nreturn [{ json: { ...previous, ai } }];"
      },
      "id": "b7c1fce7-0049-46b6-bf1f-767413996bb6",
      "name": "14 - Parse JSON da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "const ai = $json.ai || {};\nconst draft = {\n  ...($json.draft || {}),\n  ...(ai.servico ? { servico: ai.servico } : {}),\n  ...(ai.veiculo ? { veiculo: ai.veiculo } : {}),\n  ...(ai.data_desejada ? { data_desejada: ai.data_desejada } : {}),\n  ...(ai.hora_desejada ? { hora_desejada: ai.hora_desejada } : {})\n};\n\nconst body = {\n  nome: $json.incoming.pushName || $json.cliente?.nome || \"\",\n  draft_servico: draft.servico || null,\n  draft_veiculo: draft.veiculo || null,\n  draft_data: draft.data_desejada || null,\n  draft_hora: draft.hora_desejada || null,\n  updated_at: new Date().toISOString()\n};\n\nreturn [{ json: { ...$json, draft, supabase_body: body } }];"
      },
