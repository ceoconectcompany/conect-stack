    },
    {
      "parameters": {
        "jsCode": "// ===================================================\n// CONFIG CLIENTE — TEMPLATE GENÉRICO PARA VENDA\n// Edite somente este node em cada cliente.\n// ===================================================\nconst config = {\n  empresa: {\n    nome: \"NOME_DO_CLIENTE\",\n    cidade: \"CIDADE_DO_CLIENTE\",\n    telefone_responsavel: \"55DDDNUMERO\",\n    waha_base_url: \"http://IP_DA_VPS:3000\",\n    waha_api_key: \"SUA_WAHA_API_KEY\",\n    session: \"default\"\n  },\n\n  supabase: {\n    url: \"https://SEU_PROJECT_REF.supabase.co\",\n    service_role_key: \"SUA_SUPABASE_SERVICE_ROLE_KEY\"\n  },\n\n  openai: {\n    api_key: \"SUA_OPENAI_API_KEY\",\n    model: \"gpt-4o-mini\"\n  },\n\n  atendimento: {\n    timezone: \"America/Campo_Grande\",\n    linguagem: \"pt-BR\",\n    mensagem_humano: \"Perfeito, vou chamar um responsável para te ajudar melhor.\",\n    mensagem_fora_escopo: \"Hoje consigo te ajudar com agendamento de estética automotiva.\"\n  },\n\n  lembrete: {\n    timezone: \"America/Campo_Grande\",\n    lembrete_antes_minutos: 60\n  },\n\n  relatorio: {\n    timezone: \"America/Campo_Grande\",\n    enviar_mesmo_sem_movimento: true\n  },\n\n  servicos: {\n    simples: {\n      codigo: \"simples\",\n      nome: \"SERVIÇO 1\",\n      descricao: \"DESCRIÇÃO DO SERVIÇO 1\",\n      preco: 0,\n      preco_texto: \"R$ 0,00\",\n      tempo_texto: \"TEMPO ESTIMADO\"\n    },\n    detalhada: {\n      codigo: \"detalhada\",\n      nome: \"SERVIÇO 2\",\n      descricao: \"DESCRIÇÃO DO SERVIÇO 2\",\n      preco: 0,\n      preco_texto: \"R$ 0,00\",\n      tempo_texto: \"TEMPO ESTIMADO\"\n    }\n  }\n};\n\nreturn [{ json: { raw: $json, config } }];"
      },
      "id": "58682e5c-8185-4a2c-9827-2b47685ecb08",
      "name": "01 - CONFIG CLIENTE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "function digits(v) {\n  return String(v || \"\").replace(/\\D/g, \"\");\n}\n\nfunction txt(v) {\n  return String(v || \"\").trim();\n}\n\nconst raw = $json.raw || {};\nconst config = $json.config;\n\nconst incoming = {\n  from: digits(raw.from || raw.body?.from || raw.payload?.from || raw.sender || raw.chatId || raw.key?.remoteJid),\n  body: txt(raw.body?.body || raw.body?.text || raw.body || raw.text || raw.message || raw.payload?.body || raw.payload?.text || raw.message?.body),\n  pushName: txt(raw.pushName || raw.body?.pushName || raw._data?.notifyName || raw.name || \"\")\n};\n\nreturn [{ json: { config, incoming } }];"
      },
