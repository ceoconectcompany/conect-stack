      "id": "8f011a22-a6f6-407f-80b2-35b1320aeb13",
      "name": "13 - OpenAI via HTTP - Interpretar Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        -40
      ]
