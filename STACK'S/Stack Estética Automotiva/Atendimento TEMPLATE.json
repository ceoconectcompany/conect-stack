    {
      "parameters": {
        "jsCode": "const s = $json.config.servicos;\nconst text = `Claro. A diferença é:\n\n🧼 ${s.simples.nome}\n${s.simples.descricao}\nValor: ${s.simples.preco_texto}\nTempo estimado: ${s.simples.tempo_texto}\n\n✨ ${s.detalhada.nome}\n${s.detalhada.descricao}\nValor: ${s.detalhada.preco_texto}\nTempo estimado: ${s.detalhada.tempo_texto}\n\nQual delas você prefere agendar?`;\n\nreturn [{ json: { ...$json, destino: \"cliente\", text } }];"
